name: Generate Badges

on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install Dependencies
        run: pip install Pillow

      - name: Run Script
        run: python generate_badges.py

      - name: Upload Zipped PNGs
        uses: actions/upload-artifact@v4
        with:
          name: nuvio-badges-package
          path: nuvio_badges/
